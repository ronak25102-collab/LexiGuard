# ============================================
# LexiGuard Environment Configuration
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- LLM Provider (choose one) ---
# OpenAI (recommended for portfolio projects)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Google Gemini (free tier alternative)
# GOOGLE_API_KEY=your-google-api-key-here
# GOOGLE_MODEL=gemini-1.5-flash

# NVIDIA NIM (free developer access for prototyping; OpenAI-compatible)
# NVIDIA_API_KEY=your-nvidia-api-key-here
# NVIDIA_MODEL=mistralai/mistral-nemotron
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_THINKING=false
# NVIDIA_REASONING_EFFORT=low
# NVIDIA_MAX_TOKENS=2048
# NVIDIA_TIMEOUT=90
# NVIDIA_MAX_RETRIES=0

# Active LLM provider: "openai", "google", or "nvidia"
LLM_PROVIDER=openai

# --- Neo4j Aura ---
# Sign up free at: https://neo4j.com/cloud/aura-free/
NEO4J_URI=neo4j+s://your-db-id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password-here

# --- LlamaCloud (optional, for premium PDF parsing) ---
# LLAMA_CLOUD_API_KEY=your-llama-cloud-api-key-here

# --- Application ---
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
MAX_RETRIES=3
# AGENT_MAX_RETRIES=0

# --- Rate Limiting & Cost Control ---
# Limit chunks per contract to save API calls (each chunk = 1 API call)
MAX_CHUNKS_PER_CONTRACT=3
# Maximum characters per chunk
MAX_CHUNK_SIZE=30000
# Maximum simultaneous contract processing (prevents API rate limit)
MAX_CONCURRENT_UPLOADS=2
# Enable rate limiting (set to false to disable all limits)
ENABLE_RATE_LIMITING=true
